#!/bin/sh
# Versioned commit-msg hook (enabled together with pre-commit by `make hooks`).
#
#   * rejects AI attribution: Co-Authored-By Claude/Anthropic trailers,
#     Claude-Session trailers, "Generated with Claude Code" footers
#   * enforces Conventional Commits: `type(scope)!: summary`, <= 72 chars,
#     type in feat fix docs style refactor perf test build ci chore revert
set -eu

fail() {
  printf 'commit-msg: %s\n' "$1" >&2
  exit 1
}

msg=$(grep -v '^#' "$1" || true)
subject=$(printf '%s\n' "$msg" | sed -n '/[^[:space:]]/{p;q;}')

if printf '%s\n' "$msg" \
  | grep -qiE '^co-authored-by:.*(claude|anthropic)|^claude-session:|generated with \[?claude|noreply@anthropic\.com'; then
  fail "AI attribution is not allowed in commit messages (see CLAUDE.md)"
fi

case "$subject" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

if ! printf '%s\n' "$subject" \
  | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ]'; then
  fail "subject must follow Conventional Commits, e.g. 'feat(blocking): add name-token index'
  got: $subject"
fi

if [ "${#subject}" -gt 72 ]; then
  fail "subject is ${#subject} chars; keep it <= 72"
fi
